# Copy to .env.staging for local staging release builds (optional).
# Project: pawple-staging — provision via CEO; store real keys in EAS Secrets for CI builds.

EXPO_PUBLIC_PAWPLE_ENV=staging
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key-here

# Controlled Tester path for mating/chat UI (PAW-203). Staging Tester builds only — never production.
# Do not commit a live .env with this set. Do not add to eas.json.
# EXPO_PUBLIC_MATING_TEST_SURFACES=1
