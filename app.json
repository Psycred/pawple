{
  "expo": {
    "name": "Pawple",
    "slug": "pawple",
    "version": "1.0.0",
    "scheme": "pawple",
    "orientation": "portrait",
    "icon": "./assets/brand/dist/store-play-512.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/dist/adaptive-foreground-432.png",
        "backgroundImage": "./assets/brand/dist/adaptive-background-432.png"
      },
      //"edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "pawple.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.pawple.com",
              "pathPrefix": "/invite"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "pawple.app",
              "pathPrefix": "/moment"
            },
            {
              "scheme": "https",
              "host": "pawple.app",
              "pathPrefix": "/meetup"
            }
          ]
        }
      ],
      "package": "com.anonymous.Pawple"
    },
    "ios": {
      "bundleIdentifier": "com.psycredinnovation.pawple",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:pawple.com",
        "applinks:www.pawple.com",
        "applinks:pawple.app"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pawple uses your photos to add optional pictures of your pet.",
        "NSCameraUsageDescription": "Pawple uses your camera to add optional photos of your pet.",
        "NSLocationWhenInUseUsageDescription": "Pawple uses approximate location only while you're in the app to show nearby Moments and Meetups and approximate distance in Discover. Location is not tracked in the background.",
        "NSLocationDefaultAccuracyReduced": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "68afa50f-2be0-4fa1-8b17-752794ca967f"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pawple uses approximate location only while you're in the app to show nearby Moments and Meetups and approximate distance in Discover. Location is not tracked in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pawple uses your photos to add optional pictures of your pet.",
          "cameraPermission": "Pawple uses your camera to add optional photos of your pet."
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "owner": "psycred-innovation"
  }
}
