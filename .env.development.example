# Copy to .env.development for local Metro / debug builds.
# Project: pawple-dev (interim: your-dev-project-id)
# PAW-214 Mating/Chat proof scratch (not live): uyhomshmzausgylxcwia
# See docs/PAW214_NON_LIVE_MATING_CHAT_BACKEND.md — put real keys only in gitignored .env.development.
# PAW-246: Welcome "Continue with dev session" needs Auth → Anonymous Sign-Ins enabled on this project
# (Management API: external_anonymous_users_enabled=true). Never enable anonymous on live/production.

EXPO_PUBLIC_PAWPLE_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key-here

# Expo push tokens (Phase 5). Set after `npm run eas:init`, or paste from expo.dev project settings.
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid

# Controlled Tester path for mating/chat UI (PAW-203). Local/staging only — never production.
# Do not commit a live .env with this set. Restart Metro after enabling.
# EXPO_PUBLIC_MATING_TEST_SURFACES=1

# Dev-only structured logs (Metro / debug builds). Release APKs ignore this.
#   camera (default) | all | camera,auth | off
# EXPO_PUBLIC_PAWPLE_DIAGNOSTICS=camera
